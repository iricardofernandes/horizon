.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# local infrastructure state
infra/data/
infra/verdaccio/storage/

# tooling
.DS_Store
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# claude code local settings
.claude/settings.local.json
