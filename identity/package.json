{
  "name": "@horizon/identity",
  "version": "0.0.0",
  "private": true,
  "description": "Tenants, users, authentication, sessions, API keys, JWKS and role assignment.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --enable-source-maps -r @swc-node/register src/main/main.ts",
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --quiet --ignore '**/*.spec.ts,**/*.e2e-spec.ts'",
    "start": "node --enable-source-maps dist/main/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "audit:verify": "node --enable-source-maps dist/infrastructure/cli/verify-audit.js"
  },
  "dependencies": {
    "@casl/ability": "^7.0.2",
    "@horizon/contracts": "0.65.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/server": "14.0.3",
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.1.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/testing": "^12.1.3",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "testcontainers": "^12.1.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
