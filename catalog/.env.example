# catalog/.env.example — copy to .env and fill in.
# Exhaustive by design: configuration is validated with Zod at boot, and the
# process refuses to start rather than failing at first use (ADR 0005).
# No real values ever live in this file.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
# HTTP port. Behind Kong in every environment; exposed directly only in local development.
PORT=3002
# pino level. `info` in production.
LOG_LEVEL=debug

# --- persistence -----------------------------------------------------------
# Application role. Holds neither SUPERUSER nor BYPASSRLS, so RLS applies to it (ADR 0017).
DATABASE_URL=postgres://horizon_app:horizon@localhost:5432/horizon_catalog
# Owner role, used only by `db:migrate`. The application never connects with it.
DATABASE_MIGRATION_URL=postgres://horizon_owner:horizon@localhost:5432/horizon_catalog
# Bulkhead: the pool this service may consume (ADR 0027).
DATABASE_POOL_MAX=10
# Separate relay role, granted access only to outbox. Omit to disable the local relay.
DATABASE_RELAY_URL=postgres://horizon_relay:horizon@localhost:5432/horizon_catalog
# No query waits without a bound.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- redis and messaging ---------------------------------------------------
# Denylist, idempotency records, rate counters.
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://horizon:horizon@localhost:5672
# Bounded consumer concurrency (ADR 0027).
AMQP_PREFETCH=20
# The currency a new tenant's base price list is created in. identity.tenant.created
# carries no currency, so this is a starting point, not a claim about the tenant.
DEFAULT_PRICE_LIST_CURRENCY=BRL
# Relay poll interval; the floor on publish latency (ADR 0024).
OUTBOX_POLL_INTERVAL_MS=1000
# Rows claimed per poll with FOR UPDATE SKIP LOCKED.
OUTBOX_BATCH_SIZE=100
# Must exceed the maximum possible redelivery window.
INBOX_RETENTION_DAYS=30

# --- resilience (ADR 0027) -------------------------------------------------
# 24 hours (ADR 0028).
IDEMPOTENCY_TTL_SECONDS=86400
# Keys the idempotency record scope and encrypts its cached response body. At least 32
# characters. A secret manager supplies it outside development; it is never committed.
IDEMPOTENCY_SECRET=change-me-in-every-environment
# Every outbound HTTP call. There is no unbounded wait anywhere.
HTTP_CLIENT_TIMEOUT_MS=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
# How long the breaker stays open before half-open probing.
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# --- authentication --------------------------------------------------------
# Identity's public keys, for local token re-verification.
JWKS_URL=http://localhost:3001/.well-known/jwks.json
# The oldest token Catalog accepts, independent of the lifetime Identity issues (ADR 0018).
ACCESS_TOKEN_MAX_AGE_SECONDS=900
# When false the service re-verifies every token itself, so reaching its port directly grants nothing (ADR 0008).
TRUST_GATEWAY_JWT=false

# --- observability (ADR 0033) ----------------------------------------------
# The Collector. Nothing talks to a backend directly (ADR 0033).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=catalog
# Full sampling locally; errors are always sampled.
OTEL_TRACES_SAMPLER_ARG=1.0
# Tenant ids are hashed before appearing in logs and metrics (ADR 0033).
TENANT_ID_HASH_SALT=change-me-in-every-environment
