// Grafana Alloy collects container logs and ships them to Loki.
// Promtail is deprecated and is not used (ADR 0033).

logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Only Horizon's own containers; the platform's noise is not worth indexing.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "horizon"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { source = "docker" }
  forward_to = [loki.process.horizon.receiver]
}

// Services emit structured JSON with traceId and spanId on every line. Lifting them
// out here is what makes a Loki result clickable through to the trace in Jaeger.
loki.process "horizon" {
  stage.json {
    expressions = {
      level   = "level",
      traceId = "traceId",
      spanId  = "spanId",
    }
  }

  stage.labels {
    values = { level = "" }
  }

  stage.structured_metadata {
    values = { traceId = "", spanId = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
