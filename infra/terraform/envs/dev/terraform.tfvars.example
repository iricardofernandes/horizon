environment                = "dev"
aws_region                 = "us-east-1"
vpc_cidr                   = "10.20.0.0/16"
nat_gateway_per_az         = false
certificate_arn            = null
image_tag                  = "candidate"
desired_count              = 1
task_cpu                   = 256
task_memory                = 512
rds_instance_class         = "db.t4g.micro"
rds_allocated_storage      = 20
rds_multi_az               = false
rds_deletion_protection    = false
backup_retention_days      = 1
redis_node_type            = "cache.t4g.micro"
redis_replicas             = 0
redis_automatic_failover   = false
mq_instance_type           = "mq.m7g.medium"
mq_deployment_mode         = "SINGLE_INSTANCE"
log_retention_days         = 7

# Runtime-only application secrets are pre-provisioned by the security bootstrap and
# supplied as environment-specific ARNs. Never put secret values in this file.
service_secret_arns = {}
