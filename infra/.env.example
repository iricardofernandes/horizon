# infra/.env.example — copy to infra/.env only if a default port collides.
#
# Compose reads infra/.env automatically. Every published port has a conventional
# default; override only what conflicts with something already running on your machine.
# Nothing here changes container-to-container addressing, which always uses the service
# name and the container port.

# HORIZON_POSTGRES_PORT=5432
# HORIZON_REDIS_PORT=6379
# HORIZON_RABBITMQ_PORT=5672
# HORIZON_RABBITMQ_UI_PORT=15672
# HORIZON_VERDACCIO_PORT=4873

# HORIZON_OTLP_GRPC_PORT=4317
# HORIZON_OTLP_HTTP_PORT=4318
# HORIZON_COLLECTOR_METRICS_PORT=8889
# HORIZON_COLLECTOR_HEALTH_PORT=13133
# HORIZON_JAEGER_PORT=16686
# HORIZON_PROMETHEUS_PORT=9090
# HORIZON_LOKI_PORT=3100
# HORIZON_ALLOY_PORT=12345
# HORIZON_GRAFANA_PORT=3300
# HORIZON_MCP_DEBUGGER_PORT=7801
# Local-only defaults exist for these; override both outside local development.
# HORIZON_MCP_BEARER_TOKEN=horizon-local-debugger-token-change-me
# HORIZON_TENANT_HASH_SALT=horizon-local-tenant-hash-salt
# HORIZON_DEBUG_PASSWORD=horizon
# Tenant-scoped service token with Parties/Identity fiscal-reader and Catalog read roles.
# Required only with the optional fiscal Compose profile.
# HORIZON_FISCAL_SERVICE_KEYS_JSON={}

# HORIZON_KONG_PROXY_PORT=8000
# HORIZON_KONG_ADMIN_PORT=8001
