{
  "name": "@horizon/mcp-debugger",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP server over the Horizon observability plane.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "horizon-mcp-debugger": "./dist/main.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --quiet --ignore '**/*.spec.ts,**/*.e2e-spec.ts'",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "pgsql-ast-parser": "^12.0.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
