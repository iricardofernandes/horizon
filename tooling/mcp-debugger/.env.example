# tooling/mcp-debugger/.env.example — copy to .env and fill in.
#
# Every value here is operator configuration. The server holds no business
# credentials and cannot write to anything (ADR 0035).

# Master switch. Horizon runs fully with this false and no key present.
HORIZON_MCP_DEBUGGER_ENABLED=false

# --- transport ---------------------------------------------------------------
# `stdio` for local Claude Code, `http` for a remote operator.
MCP_TRANSPORT=stdio
# Bound to localhost by default. Exposing this is a deliberate act.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=7801
# Required when MCP_TRANSPORT=http. No default; the server refuses to start without it.
MCP_BEARER_TOKEN=

# --- observability sources (read-only) ---------------------------------------
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=horizon
RABBITMQ_MANAGEMENT_PASSWORD=

# --- database (dedicated least-privilege role) -------------------------------
# This role holds no privileges on business tables. describe_schema reads pg_catalog;
# explain_query goes through a SECURITY DEFINER function that parses the statement and
# rejects anything but a single SELECT; get_slow_queries needs pg_read_all_stats, which
# grants statistics access, not data access. See ADR 0035.
DEBUG_DATABASE_URLS=identity=postgres://horizon_debug:@localhost:5432/horizon_identity

# --- safety ------------------------------------------------------------------
# Tenant ids are hashed with the same salt the services use, so the two agree.
TENANT_ID_HASH_SALT=change-me-in-every-environment
# Comma-separated field names masked before any payload leaves the server. Masking is
# one-way: no tool reverses it, so a compromised agent cannot ask for the plaintext.
PII_MASK_FIELDS=email,cpf,cnpj,phone,address,name,ip
MAX_RESULT_ROWS=500
MAX_RESULT_BYTES=262144
RATE_LIMIT_PER_TOOL_PER_MINUTE=30
AUDIT_LOG_PATH=./mcp-debugger-audit.log
