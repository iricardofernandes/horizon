{
  "name": "@horizon/probe",
  "version": "0.0.0",
  "private": true,
  "description": "Walks the critical path through the gateway every minute and exposes the outcome to Prometheus (Phase 70).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --quiet --ignore '**/*.spec.ts'",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
