# agent/.env.example — copy to .env and fill in.
# Exhaustive by design: configuration is validated with Zod at boot, and the
# process refuses to start rather than failing at first use (ADR 0005).
# No real values ever live in this file.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
# HTTP port. Behind Kong in every environment; exposed directly only in local development.
PORT=3015

# --- persistence -----------------------------------------------------------
# Application role. Holds neither SUPERUSER nor BYPASSRLS, so RLS applies to it (ADR 0017).
DATABASE_URL=postgres://horizon_app:horizon@localhost:5432/horizon_agent
# Owner role, used only by `db:migrate`. The application never connects with it.
DATABASE_MIGRATION_URL=postgres://horizon_owner:horizon@localhost:5432/horizon_agent
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- the gateway (ADR 0065) ------------------------------------------------
# Every exchange and every read goes through Kong with the caller's own token.
GATEWAY_URL=http://localhost:8000
GATEWAY_TIMEOUT_MS=10000
# A list returns at most this many rows, and any answer at most this many bytes.
AGENT_MAX_ROWS=50
AGENT_MAX_RESULT_BYTES=65536

# --- authentication --------------------------------------------------------
# Identity's public keys, for the settings and audit routes a person calls.
JWKS_URL=http://localhost:3001/.well-known/jwks.json
ACCESS_TOKEN_MAX_AGE_SECONDS=900

# --- the in-app assistant (Phase 76, ADR 0069) -----------------------------
# Erasures of people reach the assistant through the broker.
# This module's own broker user: it reads its own queues and publishes nothing (ADR 0075).
RABBITMQ_URL=amqp://agent:agent-local@localhost:5672
# Wraps each person's conversation key: 64 hex characters or 32 bytes of base64.
ASSISTANT_MASTER_KEY=replace-with-64-hex-characters-generated-locally-0000000000000
# `extractive` (deterministic, nothing leaves the stack) or `anthropic`.
ASSISTANT_GENERATOR=extractive
ASSISTANT_MODEL=claude-opus-5-5
# Only with ASSISTANT_GENERATOR=anthropic. Without it the assistant says so and sends nothing.
# ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ASSISTANT_TIMEOUT_MS=60000
ASSISTANT_PURGE_INTERVAL_MS=3600000

# --- observability (ADR 0033) ----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agent
