DATABASE_URL=postgres://horizon_app:horizon@localhost:5432/horizon_fiscal
DATABASE_MIGRATION_URL=postgres://horizon_owner:horizon@localhost:5432/horizon_fiscal
# This module's own broker user: it publishes only `fiscal.*` events (ADR 0075).
RABBITMQ_URL=amqp://fiscal:fiscal-local@localhost:5672
PARTIES_URL=http://localhost:3006
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
REDIS_URL=redis://localhost:6379
PORT=3011
# Keep this 32-byte key across restarts and object restores.
FISCAL_ARTIFACT_KEY_HEX=
FISCAL_ARTIFACT_BUCKET=horizon-fiscal-artifacts
FISCAL_ARTIFACT_REGION=us-east-1
# Set FISCAL_ARTIFACT_ENDPOINT for a reachable S3-compatible service.
# FISCAL_ARTIFACT_ENDPOINT=http://localhost:9000
# Worker: JSON map of tenant IDs to rotatable Identity API keys.
FISCAL_SERVICE_KEYS_JSON={}
# Optional path to a mounted Phase 43 worker config containing only credential and source paths.
# FISCAL_PHASE43_WORKER_CONFIG_PATH=/run/secrets/fiscal-phase43-worker.json
# Pinned PL 010f package; enables supplier NF-e imports (Phase 44).
# FISCAL_INBOUND_SCHEMA_PATH=/run/fiscal-schemas/pl-010f-v1.04.zip
# Backfill: one tenant key at a time.
FISCAL_SERVICE_API_KEY=
# Required only by the backfill command.
TENANT_ID=
