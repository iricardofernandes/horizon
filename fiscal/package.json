{
  "name": "@horizon/fiscal",
  "version": "0.0.0",
  "private": true,
  "description": "Fiscal ingress, restricted projections and durable records.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup src/worker.ts src/backfill-cli.ts src/phase41-rollout-cli.ts --format cjs --platform node --out-dir dist --clean",
    "start": "node dist/worker.js",
    "backfill": "node dist/backfill-cli.js",
    "phase41:rollout": "node dist/phase41-rollout-cli.js",
    "phase42:verify-sources": "node scripts/verify-phase42-sources.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@horizon/contracts": "0.27.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "amqplib": "2.0.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "12.1.0",
    "@types/amqplib": "0.10.8",
    "@types/node": "^26.5.1",
    "testcontainers": "12.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
