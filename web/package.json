{
  "name": "@horizon/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js frontend, consuming the Horizon API through Kong.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-ui-copy.mjs",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:browser": "node scripts/golden-path.e2e.mjs",
    "test:watch": "vitest",
    "seed:hosted": "node scripts/seed-hosted-demo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/colors": "^3.0.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
