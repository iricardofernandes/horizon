# web/.env.example — copy to .env.local and fill in.

NODE_ENV=development

# Every request goes through Kong. The frontend never addresses a service directly,
# so it inherits the gateway's authentication, rate limiting and tracing (ADR 0008).
HORIZON_API_URL=http://localhost:8000

# Browser-visible. Must not carry a secret.
NEXT_PUBLIC_HORIZON_API_URL=http://localhost:8000

# OpenTelemetry — browser spans join the backend trace (ADR 0033)
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=web
