{
  "name": "@horizon/sales",
  "version": "0.0.0",
  "private": true,
  "description": "Customers, quotes, sales orders and the invoicing trigger.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --enable-source-maps -r @swc-node/register src/main/main.ts",
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --quiet",
    "start": "node --enable-source-maps dist/main/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.1.0",
    "opossum": "^10.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/testing": "^12.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.5.0",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
