# reporting/.env.example — copy to .env and fill in.
# Exhaustive by design: configuration is validated with Zod at boot, and the
# process refuses to start rather than failing at first use (ADR 0005).
# No real values ever live in this file.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
# HTTP port. Behind Kong in every environment; exposed directly only in local development.
PORT=3013
# pino level. `info` in production.
LOG_LEVEL=debug

# --- persistence -----------------------------------------------------------
# Application role. Holds neither SUPERUSER nor BYPASSRLS, so RLS applies to it (ADR 0017).
DATABASE_URL=postgres://horizon_app:horizon@localhost:5432/horizon_reporting
# Owner role, used only by `db:migrate`. The application never connects with it.
DATABASE_MIGRATION_URL=postgres://horizon_owner:horizon@localhost:5432/horizon_reporting
# Bulkhead: the pool this service may consume (ADR 0027).
DATABASE_POOL_MAX=10
# No query waits without a bound.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- messaging -------------------------------------------------------------
RABBITMQ_URL=amqp://horizon:horizon@localhost:5672
# Bounded concurrency of the live queue (ADR 0027). The replay queue always takes one at a time.
AMQP_PREFETCH=20

# --- reconciliation (Phase 62) ----------------------------------------------
# Owners' reports are read through the gateway, with the token of the person who asked.
GATEWAY_URL=http://localhost:8000

# --- exports (Phase 63) -----------------------------------------------------
# Optional in the API process; when present, the export worker finds its tenants as this role.
DATABASE_RELAY_URL=postgres://horizon_relay:horizon@localhost:5432/horizon_reporting
# `s3` (MinIO in the local stack) or `file` (a directory).
EXPORT_STORE=s3
EXPORT_BUCKET=horizon-exports
EXPORT_S3_ENDPOINT=http://localhost:9000
EXPORT_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=horizon-fiscal-local
AWS_SECRET_ACCESS_KEY=horizon-fiscal-local-secret
EXPORT_FILE_ROOT=/tmp/horizon-exports
# Signs download links, valid for 15 minutes; 32 characters or more, never shared.
EXPORT_LINK_SECRET=change-me-to-a-long-random-secret-of-32-chars
# How long a written file is kept, and how long a scheduled run waits for its cutoff to settle.
EXPORT_RETENTION_HOURS=72
EXPORT_SETTLE_GRACE_MS=3600000
EXPORT_POLL_INTERVAL_MS=5000
# A running export older than this lost its worker and is taken again.
EXPORT_LEASE_MS=600000

# --- authentication --------------------------------------------------------
# Identity's public keys, for local token re-verification.
JWKS_URL=http://localhost:3001/.well-known/jwks.json
# When false the service re-verifies every token itself, so reaching its port directly grants nothing (ADR 0008).
TRUST_GATEWAY_JWT=false
ACCESS_TOKEN_MAX_AGE_SECONDS=900

# --- observability (ADR 0033) ----------------------------------------------
# The Collector. Nothing talks to a backend directly (ADR 0033).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=reporting
# Full sampling locally; errors are always sampled.
OTEL_TRACES_SAMPLER_ARG=1.0
# Tenant ids are hashed before appearing in logs and metrics (ADR 0033).
TENANT_ID_HASH_SALT=change-me-in-every-environment
